#!/bin/sh
# Dipasang tempa init.
command -v tempa >/dev/null 2>&1 || {
  echo "tempa: perintah tidak ditemukan di PATH hook ini." >&2
  echo "Pasang tempa, atau tambahkan lokasinya ke PATH aplikasi git kamu (mis. Sourcetree: jalankan dari terminal, atau atur PATH sistem)." >&2
  exit 1
}
exec tempa sync --fix
