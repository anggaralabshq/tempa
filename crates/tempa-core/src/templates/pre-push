#!/bin/sh
# Installed by tempa init.
command -v tempa >/dev/null 2>&1 || {
  echo "tempa: command not found on this hook's PATH." >&2
  echo "Install tempa, or add its location to your git client's PATH (e.g. Sourcetree: launch it from a terminal, or set the system PATH)." >&2
  exit 1
}
exec tempa check
